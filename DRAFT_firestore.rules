rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sandrordacsilva8@gmail.com' ||
        request.auth.token.email == 'admin_church_leader@desafioteen.internal' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 50;
    }

    function isValidChallenge(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.xp is number;
    }

    function isValidDevotional(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.verse is string && data.verse.size() <= 200;
    }

    function isValidBook(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.author is string && data.author.size() <= 100;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidChallenge(incoming());
      allow delete: if isAdmin();
    }

    match /devotionals/{devotionalId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidDevotional(incoming());
      allow delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBook(incoming());
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
